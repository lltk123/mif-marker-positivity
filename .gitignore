# Publish only reviewed source, documentation, configurations, summary CSVs and figures.
*
!.gitignore
!.gitattributes
!README.md
!REPORTING_CONVENTION.md
!pyproject.toml
!requirements-dev.txt
!requirements-features.txt
!docs/
!docs/**
!tools/
!tools/**/*.py
!tests/
!tests/**/*.py
!analyses/
!analyses/**/
!analyses/**/*.py
!analyses/**/*.md
!analyses/**/*.json
!analyses/**/*.csv
!analyses/**/*.txt
!analyses/**/figures/**/*.png
!analyses/**/figures/**/*.svg
!analyses/**/figures/**/*.pdf
!analyses/**/review/samples/*.png
!analyses/cd8_tabm_20261029/development_review/**/*.png
!analyses/cd8_tabm_20261029/development_review/**/*.svg

